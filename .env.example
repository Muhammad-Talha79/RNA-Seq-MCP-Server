# run_agent.py uses Ollama locally by default. Local mode needs no cloud key.
MODEL_MODE=local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional hybrid/cloud model. Configure only when you want cloud inference.
# Supported providers: groq, gemini, openai, compatible.
CLOUD_PROVIDER=groq
# GROQ_API_KEY=replace_with_your_groq_api_key
# GEMINI_API_KEY=replace_with_your_gemini_api_key
# OPENAI_API_KEY=replace_with_your_openai_api_key
# For compatible OpenAI-style APIs, set CLOUD_API_KEY, CLOUD_BASE_URL, CLOUD_MODEL.

# Optional Tavily public web search. Sent to the WSL MCP process by run_agent.py.
# TAVILY_API_KEY=replace_with_your_tavily_api_key
